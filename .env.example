# PostgreSQL bağlantısı (docker-compose ile: postgres://emparos:emparos@localhost:5434/emparos)
DATABASE_URL=postgres://emparos:emparos@localhost:5434/emparos

# İlk admin kullanıcısı (db:seed ile oluşturulur)
SEED_ADMIN_EMAIL=admin@emparos.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=degistir-beni

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
